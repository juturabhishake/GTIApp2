{
  "expo": {
    "name": "GTIAppProject",
    "slug": "GTIAppProject",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gti_icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to your camera to scan QR codes."
      },
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gti.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.GTIAppProject"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-splash-screen",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "575e53fa-0b95-4242-8fc2-888f86f39869"
      }
    }
  }
}
